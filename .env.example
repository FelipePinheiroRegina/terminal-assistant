# copie para .env.local e preencha (o .env.local não é versionado)

# provider de IA: google (padrão, tem cota gratuita) ou openai
AI_PROVIDER=google

# modelo opcional; sem ele usa gemini-3.5-flash-lite (google) ou gpt-5.4-mini (openai)
# AI_MODEL=

# chave do Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# chave da OpenAI (precisa de créditos): https://platform.openai.com/api-keys
OPENAI_API_KEY=
